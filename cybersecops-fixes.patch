@@ -0,0 +1,13 @@
+# Copy this file to .env and fill in real values before running in anything
+# beyond local dev. Never commit the real .env file.
+
+DATABASE_URL=postgresql+psycopg://cybersecops:changeme_local_dev@localhost:5432/cybersecops
+REDIS_URL=redis://localhost:6379/0
+
+# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
+JWT_SECRET=change-me-dev-only-not-for-production
+JWT_ALGORITHM=HS256
+JWT_EXPIRE_MINUTES=60
+
+# Comma-separated list of origins allowed to call the API
+CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
